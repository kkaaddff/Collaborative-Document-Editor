{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coordination",
  "version": "3.0.0",
  "identifier": "online.hengheng.coordination",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "协同文档编辑器",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "协同文档编辑器",
    "longDescription": "实时协同文档编辑（Yjs CRDT）：桌面端支持托盘最近房间直达与离线缓存，可直连自建服务器。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
